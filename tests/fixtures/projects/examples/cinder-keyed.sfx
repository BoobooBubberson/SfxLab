# step 2 test, extended: whoosh + burst, each as a dry body plus a key-tracked resonance,
# and a tuned sub thump (pluck, pitch-keyed) under the impact. Pentatonic renders: --key 0 2 4 7 9
loop 0
clip whoosh-dry 5 0 0.00 1.20 11 level=0.40 keyed=0 file=minecraft_sounds_assets/fire/flame_whoosh.ogg
clip whoosh-sing 5 1 0.00 1.20 12 level=0.80 cutoff=0.43441 resonance=0.90 filter=1 reverb=0.15 keyed=2 file=minecraft_sounds_assets/fire/flame_whoosh.ogg
clip burst-dry 5 2 0.90 2.00 13 level=0.55 keyed=0 file=minecraft_sounds_assets/fire/fireball_burst.ogg
clip burst-sing 5 3 0.90 2.00 14 level=0.70 cutoff=0.30886 resonance=0.85 filter=1 reverb=0.20 keyed=2 file=minecraft_sounds_assets/fire/fireball_burst.ogg
clip thump 4 4 0.90 0.60 15 level=0.60 attack=0.002 release=0.35 pitch=-24 damp=0.6 keyed=1
