# per-machine state: export folder, forge mirror, browser toggle (see lab.cfg.example)
lab.cfg
# the workspace autosaves; S stamps named copies into projects/ (and spells/ for signatures)
project.sfx
bench.sfx
regulator/.working/

# caches, rebuilt on demand
samples/.decoded/
video-cache/
forge/.badges-*.txt
tools/__pycache__/
.build/
*.pyc

# outputs
renders/
forge/

# local-only material, kept on disk but not shared
# archive/: retired test projects and old renders; clips/: video reference recordings
archive/
clips/
*.bak

# sample library: only the cleared sets are tracked (see samples/README.md): pyretic/, and the in-lab
# gravitic/, luminal/ and aqueous/ synthesis the regulator families are built on
samples/*
!samples/README.md
!samples/CREDITS.md
!samples/pyretic/
!samples/gravitic/
!samples/luminal/
!samples/aqueous/
