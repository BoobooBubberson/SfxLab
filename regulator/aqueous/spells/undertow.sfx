name Undertow
recipe tier=2 X1p1 Y2p0 X3p0r0.4 Y4p2r0.4 Z2p1r0.5
bench 1
root 65.4064
layer bed aqueous/Aqueous_underwater_rumbling_00001 7 0.0000 5001 level=0.45000 attack=0.80000 release=1.20000 pitch=4.42000 cutoff=0.40000 echo=0.00000 reverb=0.30000 loop=1.00000 sines=1.00000 residual=1.00000 keyed=1 file=aqueous/Aqueous_underwater_rumbling_00001.ogg drive=0.10000
layer droplets aqueous/Aqueous_stream_00001 7 0.0000 5007 level=0.65000 attack=1.00000 release=1.50000 pitch=0.00000 cutoff=0.90000 reverb=0.65000 loop=1.00000 sines=1.00000 residual=0.00000 gather=1.00000 chord=1.00000 root_shift=-5.00000 keyed=1 file=aqueous/Aqueous_stream_00001.ogg
layer pull aqueous/Aqueous_bubbling_00001 5 0.0000 5011 level=0.60000 attack=1.20000 release=1.80000 pitch=-7.00000 cutoff=0.60000 reverb=0.50000 loop=1.00000 pitch_mode=0.00000 keyed=2 file=aqueous/Aqueous_bubbling_00001.ogg drive=0.25000
