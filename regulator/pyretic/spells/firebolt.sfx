name Fire bolt
recipe tier=1 X3p1 Y2p0
bench 1
root 65.4064
layer bed pyretic/pyretic_synth_00001_loop 7 0.0000 1001 level=0.20000 attack=0.30000 release=0.60000 pitch=-5.17941 cutoff=1.00000 echo=0.00000 reverb=0.00000 drive=0.00000 loop=1.00000 sines=1.00000 residual=1.00000 keyed=1 file=pyretic/pyretic_synth_00001_loop.ogg
layer cloud cloud 0 0.0000 1005 level=0.45000 attack=0.40000 release=0.80000 pitch=3.00000 cutoff=0.80000 reverb=0.40000 voices=8.00000 gather=1.00000 drift=0.25000 timbre=0.50000 chord=1.00000 sub=0.00000 keyed=1
layer fire pyretic/fire_loop 5 0.0000 1006 level=0.70000 attack=0.30000 release=0.60000 pitch=0.00000 cutoff=0.70000 loop=1.00000 keyed=2 file=pyretic/fire_loop.ogg
layer ignite pluck 4 1.2000 2001 level=0.25000 attack=0.00200 release=0.30000 pitch=3.00000 cutoff=0.80000 reverb=0.20000 keyed=1 on=lock
