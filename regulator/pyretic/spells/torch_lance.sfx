name Torch lance
recipe tier=3 X1p0 Y2p1r0.8 Z3p1r0.7 X4p2r0.4 Y5p0r0.3 Z6p3r0.25
bench 1
root 65.4064
layer bed pyretic/pyretic_synth_00001_loop 7 0.0000 1001 level=0.20000 attack=0.30000 release=0.60000 pitch=-5.17941 cutoff=1.00000 echo=0.00000 reverb=0.00000 drive=0.00000 loop=1.00000 sines=1.00000 residual=1.00000 keyed=1 file=pyretic/pyretic_synth_00001_loop.ogg
layer cloud cloud 0 0.0000 1005 level=0.45000 attack=0.40000 release=0.80000 pitch=3.00000 cutoff=0.80000 reverb=0.40000 voices=8.00000 gather=1.00000 drift=0.25000 timbre=0.50000 chord=6.00000 sub=0.00000 keyed=1
layer fire pyretic/fire_loop 5 0.0000 1006 level=0.20000 attack=0.30000 release=0.60000 pitch=0.00000 cutoff=0.50000 loop=1.00000 keyed=2 file=pyretic/fire_loop.ogg
layer torch pyretic/flamethrower_loop 5 0.0000 2006 level=0.08000 attack=0.30000 release=0.30000 pitch=0.00000 cutoff=0.60000 loop=1.00000 keyed=2 file=pyretic/flamethrower_loop.ogg
layer torch_on pyretic/flamethrower_turn-on 5 2.4300 2005 level=0.20000 attack=0.00500 release=0.05000 pitch=0.00000 cutoff=0.80000 keyed=2 on=lock file=pyretic/flamethrower_turn-on.ogg
layer torch_off pyretic/flamethrower_turn-off 5 1.4300 2007 level=0.20000 attack=0.00500 release=0.05000 pitch=0.00000 cutoff=0.80000 keyed=2 on=unlock file=pyretic/flamethrower_turn-off.ogg
bind orb.speed torch level 0.06 0.1
bind orb.curl torch cutoff 0.45 0.75
note Torch lance (tier III): ratios 1..6 -> root, fifth, third: the cloud locks a harmonic-seventh chord (the bluesy one) at C3.
note The flamethrower is a hot recording (-4 dB RMS), so it sits at 0.18 and rides the orb; turn-on fires on lock, turn-off on unlock.
