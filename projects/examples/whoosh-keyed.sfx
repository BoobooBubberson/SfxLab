# step 2 test: a recorded whoosh that sings the key.
# track 1: the recording dry (keyed=off) — the body, never transposed
# track 2: the same recording through a resonant bandpass at 440 Hz, keyed=filter,
#          so --key N (or < > in the GUI) slides the resonance by N semitones
loop 0
clip whoosh-dry 5 0 0.00 1.80 11 level=0.45 keyed=0 file=minecraft_sounds_assets/fire/flame_whoosh.ogg
clip whoosh-sing 5 1 0.00 1.80 12 level=0.85 cutoff=0.43441 resonance=0.90 filter=1 reverb=0.15 keyed=2 file=minecraft_sounds_assets/fire/flame_whoosh.ogg
